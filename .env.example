# Database connection (PostgreSQL with pgcrypto extension)
DB_HOST=localhost
DB_NAME=organ_donation
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Database encryption key (used for pgcrypto field-level encryption of PII/Medical data)
# MUST be set in production, app refuses to start on AWS without it
APP_ENC_KEY=your-database-encryption-key-here

# Flask session secret key (used to sign session cookies)
# MUST be different from APP_ENC_KEY in production
FLASK_SECRET_KEY=your-flask-session-secret-here

# JWT signing key (used to sign mobile API tokens)
# MUST be different from APP_ENC_KEY and FLASK_SECRET_KEY in production
JWT_SECRET_KEY=your-jwt-signing-secret-here

# Optional: legacy client app key (only used by standalone client.py, not needed)
CLIENT_APP_SECRET_KEY=your-client-secret

# Email - SMTP credentials for 2FA OTP and password reset emails
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AWS SES (used for breach notification emails)
SES_SENDER_EMAIL=your-ses-verified-email@example.com
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Redis URL for rate limiting (production: persists across restarts and instances)
# Falls back to in-memory if not set (fine for local dev, not for production)
# REDIS_URL=redis://your-redis-host:6379

# CORS (comma-separated origins allowed for mobile API)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Flask debug mode (set to "true" for local development only)
FLASK_DEBUG=false

# Optional: Base URL for password reset emails (avoids Host header injection)
# APP_BASE_URL=https://your-domain.com
